# Projeto Supabase do app IA.med (espelho do Notion).
SUPABASE_URL=https://iutwiaxeienjhvkvrcul.supabase.co
# Só a chave anon ou publishable (sb_publishable_...). O servidor recusa
# sb_secret_ e JWT de service_role na subida. Nunca commitar o valor.
SUPABASE_ANON_KEY=

# stdio (padrão, uso local) ou streamable-http (conector).
TRANSPORTE=stdio
HTTP_HOST=127.0.0.1
HTTP_PORTA=8107
HTTP_PATH=/mcp
HTTP_HOSTS_PUBLICOS=
HTTP_LIMITE_GLOBAL_POR_MINUTO=300
HTTP_LIMITE_POR_MINUTO=60
